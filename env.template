# Chuck's Bakes - Environment Variables Template
# Copy this file to .env and fill in your values

# Google Apps Script Web App URL
# Get this from: Google Sheets > Extensions > Apps Script > Deploy > New Deployment
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# API Security Token
# Generate a secure random string (at least 32 characters)
# Use the same token in both:
# 1. This file (for your API route)
# 2. Google Apps Script Properties (see SETUP.md)
API_ORDER_TOKEN=your-secure-random-token-here-at-least-32-characters

# Resend API Key for sending order confirmation emails
# Get this from: https://resend.com/api-keys
# IMPORTANT: This key must NEVER be exposed to the client.
# Do NOT use VITE_ prefix - this keeps it server-side only.
RESEND_API_KEY=re_VStAymHu_5TStDpTuWtiqETXudKniz71F

